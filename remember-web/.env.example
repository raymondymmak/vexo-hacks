# Copy to .env and fill in. Never commit .env.
# Leave OPENAI_API_KEY empty to run fully offline with the built-in heuristic extractor/matcher.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=20

# Optional: where the SQLite file lives (default: ./remember.db)
# REMEMBER_DB=./remember.db

# Optional: set to 1 to ignore the API key and force the offline heuristics (handy on bad Wi-Fi)
# REMEMBER_FORCE_FALLBACK=1
