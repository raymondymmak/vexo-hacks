# Your team's two keys. Copy this file to .env and fill in the values yourself:
#     macOS, Linux:   cp env.example .env
#     Windows:        copy env.example .env
# .env stays on your computer. Never commit it, never share it, never paste it.
# Speech-to-text reads DEEPGRAM_API_KEY. The card extractor reads OPENAI_API_KEY.
# Optional: OPENAI_MODEL=   (leave unset to use the kit's default model)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
