# Copy to .env and enter your own values locally. Never commit or share .env.
# Speech and contact extraction:
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL=  # optional override for the kit's extractor model

# Automatic delivery is opt-in. Offline --demo never delivers.
REMEMBER_AUTO_DELIVER=0
ICLOUD_USERNAME=
# Generate an app-specific password in your Apple Account (not your main password).
ICLOUD_APP_PASSWORD=
# Optional HTTPS iCloud address-book collection URL; empty enables discovery.
ICLOUD_ADDRESSBOOK_URL=

# Full HTTPS ntfy topic URL; manually subscribe to the same topic on your phone.
NTFY_URL=
NTFY_TOKEN=

# Optional reachable base URL of this app, used for scoped vCard fallback links.
# This does not publish the app. Use the phone-reachable URL, not localhost.
REMEMBER_PUBLIC_URL=

# Best-effort public profile lookup, only in automatic delivery mode.
REMEMBER_SOCIAL_LOOKUP=1
# With a Gemini key, the lookup uses Gemini with Google Search grounding.
GEMINI_API_KEY=
# REMEMBER_GEMINI_MODEL=gemini-2.5-flash  # optional override
# Without a Gemini key, the lookup uses OpenAI web search with this model.
REMEMBER_SOCIAL_MODEL=gpt-4.1-mini
